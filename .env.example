# Variables de entorno usadas por settings_render.py.
# En Render se configuran en el panel del servicio. Este archivo es solo
# documentación de qué variables existen y para qué sirven.

# Clave secreta de Django (Render la genera automáticamente con generateValue).
DJANGO_SECRET_KEY=cambia-esta-clave-por-una-aleatoria-larga

# Apunta a settings_render para forzar la configuración de despliegue.
DJANGO_SETTINGS_MODULE=finca_ganadera.settings_render

# Debug siempre en False en Render.
DJANGO_DEBUG=False

# Hosts permitidos. `.onrender.com` cubre el subdominio automático.
DJANGO_ALLOWED_HOSTS=.onrender.com

# URL completa de la base Postgres administrada por Render
# (se rellena automáticamente vía render.yaml).
DATABASE_URL=postgres://usuario:password@host.oregon-postgres.render.com:5432/vacweb

# Orígenes CSRF adicionales (opcional, si conectás dominio propio).
# DJANGO_CSRF_TRUSTED_ORIGINS=https://midominio.com

# SMTP opcional (por defecto manda a consola).
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# DJANGO_DEFAULT_FROM_EMAIL=no-reply@tudominio.com
